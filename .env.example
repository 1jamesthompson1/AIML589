# Copy to .env and fill in your own values. .env is gitignored; this file is
# the reference for what the repo expects. Only HF_TOKEN/hf stuff is required
# for the artifact bucket workflows (see README, "HF bucket artifacts" section).

# --- Hugging Face (required for the artifact bucket sync/backup) ---
# User access token with write access to the artifacts bucket
# (https://huggingface.co/settings/tokens)
HF_TOKEN=
# HF namespace (user or org) your repos live under
HF_ORG=
# Collection for the project's models/datasets, if any
HF_COLLECTION=

# --- HF storage bucket for heavy pipeline outputs (fine-tuning evals,
# behavioural-simulation runs). Synced by `make artifacts-sync` and on every
# git commit via pre-commit. Git-less object storage.
HF_BUCKET=1jamesthompson1/wvs-nz-value-alignment-evals

# --- Optional borg backup of the artifacts mirror (no password) ---
# Set to true to also run a borg backup after the sync in pre-commit.
RUN_BORG_BACKUP=true
# Borg repo path, relative to $HOME if not absolute; auto-initialised
# (--encryption=none) on first use.
BORG_REPO=grid-directory/AIML589-evals-backup

# --- Vast.ai (fine-tuning on rented GPUs) ---
VAST_API_KEY=
# OpenRouter (behavioural simulations via hosted models)
OPENROUTER_API_KEY=

# --- Behavioural simulation judge models (optional) ---
# Judge/audit model selection precedence: an explicit --model-role wins,
# then these variables, then the model under test. Use a strong model with
# reliable tool-call structured output (the judge's rubric schema is enforced
# as a tool call). Reasoning models spend max_tokens on hidden reasoning;
# the scorer budgets already account for that.
JUDGE_MODEL=openrouter/<provider>/<model>
AUDIT_MODEL=openrouter/<provider>/<model>