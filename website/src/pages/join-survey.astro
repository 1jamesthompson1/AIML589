---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Join the Survey — NZ Value Alignment">
  <section style="padding-top:calc(var(--nav-height) + 2rem);">
    <div class="container" style="max-width:48rem;">
      <p class="section-label">Get involved</p>
      <h1>Join the Survey</h1>

      <p style="margin-top:1.5rem;color:var(--color-muted);line-height:1.8;">
        Public consultation is a core part of this research. We are collecting multiple sets of respondents input and would be interested to know what you have to say.
      </p>

      <h2 style="margin-top:2.5rem;">What's involved?</h2>
      <ol style="margin-top:1rem;color:var(--color-muted);line-height:1.8;padding-left:1.5rem;">
        <li>Answer a few short value questions</li>
        <li>Compare responses from different AI models</li>
        <li>Tell us which outputs feel more aligned with NZ values</li>
      </ol>

      <h2 style="margin-top:2.5rem;">Status</h2>
      <p style="margin-top:1rem;color:var(--color-muted);line-height:1.8;">
        The study is awaiting ethics approval. Details and a link to
        participate will be posted here once approved.
      </p>

      <p style="margin-top:2rem;color:var(--color-muted);line-height:1.8;">
        <em>This research has been approved by the Victoria University of
        Wellington Human Ethics Committee (application pending).</em>
      </p>
    </div>
  </section>
</BaseLayout>
