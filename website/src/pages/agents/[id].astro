---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const agents = await getCollection('agents');
  return agents.map((agent) => ({
    params: { id: agent.data.id },
    props: { agent },
  }));
}

const { agent } = Astro.props;
const { Content, headings } = await render(agent);

const situationHeadings = headings.filter((h) => h.depth === 3);
---

<BaseLayout title={`${agent.data.title} — Simulation Scenarios`}>
  <section style="padding-top:calc(var(--nav-height) + 2rem);">
    <div class="container docs-layout">
      <nav class="docs-sidebar">
        <ul class="agents-nav" style="margin-bottom:1.5rem;">
          <li>
            <a href="/agents" class:list={[{ current: false }]}>Overview</a>
          </li>
        </ul>
        <p class="side-title">Simulation Scenarios</p>
        <ul class="agents-nav">
          {(await getCollection('agents')).map((a) => (
            <li>
              <a
                href={`/agents/${a.data.id}`}
                class:list={[{ current: a.data.id === agent.data.id }]}
              >
                {a.data.title}
              </a>
            </li>
          ))}
        </ul>
        <p class="side-title" style="margin-top:1.5rem;">Situations on this page</p>
        <ul class="agents-nav">
          {situationHeadings.map((h) => (
            <li>
              <a href={`#${h.slug}`}>{h.text.split('(')[0].trim()}</a>
            </li>
          ))}
        </ul>
      </nav>

      <article class="docs-content">
        <p class="section-label">{agent.data.organisation}</p>
        <h1>{agent.data.title}</h1>
        <Content />
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .docs-layout {
    display: grid;
    grid-template-columns: 16rem minmax(0, 1fr);
    gap: 2.5rem;
    align-items: start;
    padding: 0 1rem;
  }
  .docs-sidebar {
    position: sticky;
    top: calc(var(--nav-height) + 1.5rem);
    font-size: 0.85rem;
  }
  .side-title {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-muted);
    margin-bottom: 0.4rem;
  }
  .agents-nav, .docs-sidebar ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .docs-sidebar a {
    color: inherit;
    text-decoration: none;
    display: block;
    padding: 0.15rem 0;
  }
  .docs-sidebar a:hover { color: var(--color-primary); }
  .docs-sidebar a.current { font-weight: 700; color: var(--color-primary); }
  .docs-sidebar ul ul { padding-left: 0.8rem; }
  @media (max-width: 56rem) {
    .docs-layout { grid-template-columns: 1fr; }
    .docs-sidebar { position: static; }
  }

  /* Markdown typography */
  .docs-content :global(h1) {
    font-size: 1.9rem;
    margin: 0;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--color-border);
  }
  .docs-content :global(h2) {
    font-size: 1.4rem;
    margin-top: 2.5rem;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--color-border);
  }
  .docs-content :global(h3) { font-size: 1.15rem; margin-top: 2rem; }
  .docs-content :global(h4) { font-size: 0.95rem; margin-top: 1.5rem; }
  .docs-content :global(p) {
    margin: 0.8rem 0;
    line-height: 1.7;
  }
  .docs-content :global(ul) { margin: 0.5rem 0 0.8rem 0; padding-left: 1.3rem; }
  .docs-content :global(ul li) { margin: 0.25rem 0; line-height: 1.6; }
  .docs-content :global(blockquote) {
    margin: 0.6rem 0;
    padding: 0.2rem 0.9rem;
    border-left: 4px solid var(--color-border);
    color: var(--color-muted);
    white-space: pre-wrap;
  }
  .docs-content :global(a) { color: var(--color-primary); }
  .docs-content :global(code) {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 0.35rem;
    padding: 0.05rem 0.35rem;
    font-size: 0.85em;
  }
</style>
