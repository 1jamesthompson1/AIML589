---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About — NZ Value Alignment">
  <section style="padding-top:calc(var(--nav-height) + 2rem);">
    <div class="container" style="max-width:48rem;">
      <p class="section-label">About</p>
      <h1>Team</h1>
      <p style="margin-top:1rem;color:var(--color-muted);line-height:1.8;">
        <strong><a href="https://james.sjhl.nz" target="_blank" rel="noopener noreferrer">James Thompson ↗</a></strong> — Master's candidate, AIML589<br />
        <strong><a href="https://people.wgtn.ac.nz/Andrew.Lensen" target="_blank" rel="noopener noreferrer">Dr Andrew Lensen ↗</a></strong> — Supervisor<br />
        <strong><a href="https://people.wgtn.ac.nz/ali.knott" target="_blank" rel="noopener noreferrer">Dr Ali Knott ↗</a></strong> — Co-supervisor<br />
        School of Engineering and Computer Science, Victoria University of Wellington.
      </p>

      <h2 style="margin-top:3rem;">Background</h2>
      <p style="margin-top:1rem;color:var(--color-muted);line-height:1.8;">
        This work is completed as part of James Thompson's Master of Artificial Intelligence programme at Victoria University of Wellington, supervised by Dr Andrew Lensen and co-supervised by Dr Ali Knott. It builds on a summer research project (<a href="https://raw.githubusercontent.com/1jamesthompson1/AIML501/main/output/AIML501_James_Thompson.pdf" target="_blank" rel="noopener noreferrer">AIML501 ↗</a>) that explored value alignment for New Zealand.
      </p>
    </div>
  </section>
</BaseLayout>
