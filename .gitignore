**/output/*
!**.pdf
!code/**/output/*
workbench/**

# Generated by texcount during the report build (\write18)
**/report.count

**/__marimo__/
**/__pycache__/

.env

# Local mirror of the HF storage bucket (fine-tuning + behavioural-simulation
# outputs). Synced with `hf buckets sync`, backed up with borg. See
# code/hf-bucket/README.md.
artifacts/

# Fingerprint marking the artifacts/ state of the last successful borg backup
# (see Makefile artifacts-backup).
.artifacts-backup.sha

# website/public/{ft,bs} symlinks into artifacts/ created by
# `make website-local-data` for the dev server's ?local=1 mode. Never commit
# or deploy these (a build following the symlinks would bundle the whole
# artifacts mirror into the site).
website/public/ft
website/public/bs
# Qualtrics survey files carry the real account ids / generated content
survey/*.qsf
survey/reference.qsf
# managed survey id (qualtrics_sync.py state)
survey/managed-survey.txt
