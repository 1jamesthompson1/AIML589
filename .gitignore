**/output/*
!**.pdf
!code/**/output/*
workbench/**

# Generated by texcount during the report build (\write18)
**/report.count

**/__marimo__/
**/__pycache__/

.env

# Local mirror of the HF storage bucket (fine-tuning + behavioural-simulation
# outputs). Synced with `hf buckets sync`, backed up with borg. See the root
# README's HF bucket artifacts section.
artifacts/

# Fingerprint marking the artifacts/ state of the last successful borg backup
# (see Makefile artifacts-backup).
.artifacts-backup.sha

# The dev server serves artifacts/ directly; no website/public artifact
# symlinks are needed. Ignore legacy links from older checkouts.
website/public/ft
website/public/bs
# Qualtrics survey files carry the real account ids / generated content
survey/*.qsf
survey/reference.qsf
# survey-mockup.tex is generated by generate_mockup.py (which also builds the
# PDF); run that script before `make watch FILE=survey-mockup`
survey/survey-mockup.tex
# managed survey id (qualtrics_sync.py state)
survey/managed-survey.txt
