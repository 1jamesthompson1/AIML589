# Copy to .env in THIS directory and fill in your values. This directory's
# .env is gitignored and holds only what the behavioural simulations need;
# the repo-root .env keeps everything else (HF tokens, Vast, backups).

# --- OpenRouter (required) ---
# Hosted models: the agent-under-test (--model ...), the simulated
# client/candidate/people (user role fallback), and judge/audit models below.
OPENROUTER_API_KEY=

# --- Judge / audit models (optional) ---
# Scorer precedence: an explicit --model-role judge=... / audit=... wins,
# then JUDGE_MODEL / AUDIT_MODEL here, else the model under test is used.
# Prefer a strong model with reliable tool-call structured output (the
# judge's rubric-generated JSON schema is enforced as a submit_judgement
# tool call; text-only models fall back to JSON extraction from prose).
# Reasoning models spend max_tokens on hidden reasoning - the scorer
# budgets already account for that.
JUDGE_MODEL=openrouter/<provider>/<model>
AUDIT_MODEL=openrouter/<provider>/<model>

# --- Eval logs ---
# Where `inspect eval` writes logs when run from this directory
# (relative paths resolve against the directory you run from).
INSPECT_LOG_DIR=output/logs